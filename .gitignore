# ==============================================================================
# FixMate — Root Git Ignore Rules
# ==============================================================================

# 1. Secrets, Credentials & Local Environment Files
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*
**/.env.local
**/.env.*.local
backend/.env
backend/.env.demo.local
frontend/.env
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx

# 2. Dependencies & Package Manager Caches
node_modules/
**/node_modules/
.npm/

# 3. Build Outputs & Compiler Caches
dist/
**/dist/
out-tsc/
**/out-tsc/
.angular/
**/.angular/
*.tsbuildinfo

# 4. Logs & Runtime Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Test, Coverage & E2E Reports
coverage/
**/coverage/
.nyc_output/
playwright-report/
test-results/

# 6. Temporary Local Browser Verification Artifacts
artifacts/demo-accounts/
artifacts/hero-discovery-integration/
artifacts/rtl-category-navigation/

# 7. OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~
