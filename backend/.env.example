# ============================================================================
# FixMate Backend Environment Configuration Example (Phase 2)
# Copy this file to `backend/.env` for local development.
# Do NOT commit real secrets or production credentials to version control.
# ============================================================================

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP Server Port
PORT=3000

# Comma-separated list of allowed browser CORS origins
CORS_ORIGINS=http://localhost:4200

# MongoDB Connection URI
# Option A (Host NestJS -> Docker Compose MongoDB or local mongod on port 27017):
MONGODB_URI=mongodb://127.0.0.1:27017/fixmate
# Option B (Dockerized NestJS -> Docker Compose service name `mongodb`):
# MONGODB_URI=mongodb://mongodb:27017/fixmate

# ============================================================================
# Phase 2 Authentication & Session Configuration
# ============================================================================
JWT_ACCESS_SECRET=replace-with-at-least-32-char-random-secret-key
JWT_ACCESS_TTL_SECONDS=900
REFRESH_SESSION_TTL_DAYS=7

# ============================================================================
# Local CLI Admin Bootstrap Variables (Used ONLY by `npm run bootstrap:admin`)
# Never hardcoded in code; supply via environment when running the script.
# ============================================================================
# ADMIN_BOOTSTRAP_EMAIL=admin@fixmate.local
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-password
# ADMIN_BOOTSTRAP_NAME=FixMate Operations Admin

# Production (set through Render, never commit real values):
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://<database-user>:<percent-encoded-password>@<cluster-host>/fixmate?retryWrites=true&w=majority
# CORS_ORIGINS=https://<your-frontend-host>
# JWT_ACCESS_SECRET=<unique-random-secret-at-least-32-characters>
# PORT is supplied by Render. Cookies remain Secure, HttpOnly, SameSite=Lax,
# host-only and /api/v1/auth scoped; use the Vercel same-origin API proxy.
# No COOKIE_DOMAIN or SameSite=None setting is required.
